(require 'ert)
(require 'imenu)
(require 'loaddefs-gen)
(require 'newcomment)
(require 'gitfile-ts-mode)

(dolist (language '(gitignore gitattributes gitconfig mailmap))
  (unless (treesit-ready-p language t)
    (error "The %s grammar is required to run the tests" language)))

;;;; Helpers

(defun gitfile-ts-mode-test--position (fragment &optional line)
  (save-excursion
    (goto-char (point-min))
    (when line
      (let ((found nil))
        (while (and (not found) (not (eobp)))
          (if (equal line (buffer-substring-no-properties
                           (line-beginning-position) (line-end-position)))
              (setq found t)
            (forward-line 1)))
        (unless found (ert-fail (format "Missing fixture line: %S" line)))))
    (unless (search-forward fragment (and line (line-end-position)) t)
      (ert-fail (format "Missing fixture fragment: %S" fragment)))
    (- (point) (length fragment))))

(defun gitfile-ts-mode-test--face (fragment &optional offset line)
  (get-text-property (+ (gitfile-ts-mode-test--position fragment line)
                        (or offset 0)) 'face))

(defun gitfile-ts-mode-test--syntax-class (fragment &optional offset line)
  (syntax-propertize (point-max))
  (syntax-class (syntax-after (+ (gitfile-ts-mode-test--position fragment line)
                                 (or offset 0)))))

(defun gitfile-ts-mode-test--buffer-state ()
  (font-lock-ensure)
  (syntax-propertize (point-max))
  (let (state)
    (dotimes (offset (- (point-max) (point-min)))
      (let ((position (+ (point-min) offset)))
        (push (list (get-text-property position 'face) (syntax-after position)) state)))
    (nreverse state)))

(defun gitfile-ts-mode-test--should-match-fresh-buffer (level)
  (let ((source (buffer-substring-no-properties (point-min) (point-max)))
        (state (gitfile-ts-mode-test--buffer-state))
        (file buffer-file-name))
    (with-temp-buffer
      (setq buffer-file-name file)
      (insert source)
      (let ((treesit-font-lock-level level)) (gitfile-ts-mode))
      (should (equal state (gitfile-ts-mode-test--buffer-state))))))

;;;; Grammar

(ert-deftest gitfile-ts-mode-respects-grammar-sources ()
  (let ((ensure (symbol-function 'treesit-ensure-installed)) received)
    (unwind-protect
        (progn
          (fset 'treesit-ensure-installed
                (lambda (language)
                  (setq received (assq language treesit-language-source-alist))
                  t))
          (dolist (source gitfile-ts-mode--grammar-sources)
            (let* ((language (car source))
                   (custom (list language "/local/grammar" :revision "custom")))
              (dolist (configured (list nil (list custom)))
                (let ((treesit-language-source-alist configured))
                  (should (gitfile-ts-mode--ensure-grammar language))
                  (should (equal received (if configured custom source)))
                  (should (eq treesit-language-source-alist configured)))))))
      (fset 'treesit-ensure-installed ensure))))

(ert-deftest gitfile-ts-mode-reports-unavailable-selected-grammar ()
  (let ((ensure (symbol-function 'treesit-ensure-installed)) requested)
    (unwind-protect
        (progn
          (fset 'treesit-ensure-installed
                (lambda (language) (push language requested) nil))
          (with-temp-buffer
            (setq buffer-file-name "/tmp/.gitconfig")
            (should-error (gitfile-ts-mode) :type 'user-error)
            (should (equal requested '(gitconfig)))
            (should-not (treesit-parser-list))))
      (fset 'treesit-ensure-installed ensure))))

;;;; Mode Selection

(ert-deftest gitfile-ts-mode-selects-only-the-file-grammar ()
  (let ((ensure (symbol-function 'treesit-ensure-installed)) requested)
    (unwind-protect
        (progn
          (fset 'treesit-ensure-installed
                (lambda (language) (push language requested) t))
          (pcase-dolist (`(,file . ,language)
                         '(("/tmp/.gitignore" . gitignore)
                           ("project.gitignore" . gitignore)
                           ("/tmp/.gitattributes" . gitattributes)
                           ("work.gitattributes" . gitattributes)
                           ("/tmp/.gitconfig" . gitconfig)
                           ("work.gitconfig" . gitconfig)
                           (".gitmodules" . gitconfig)
                           ("/tmp/.gitmodules" . gitconfig)
                           ("test.gitmodules" . gitconfig)
                           ("/tmp/project.gitmodules" . gitconfig)
                           (".mailmap" . mailmap)
                           ("/tmp/.mailmap" . mailmap)
                           ("test.mailmap" . mailmap)
                           ("/tmp/project.mailmap" . mailmap)))
            (with-temp-buffer
              (setq buffer-file-name file requested nil)
              (insert "# note\n")
              (set-auto-mode)
              (font-lock-ensure)
              (should (eq major-mode 'gitfile-ts-mode))
              (should (equal requested (list language)))
              (should (eq (treesit-parser-language treesit-primary-parser) language))
              (should (equal (treesit-parser-list) (list treesit-primary-parser)))
              (gitfile-ts-mode)
              (should (equal (treesit-parser-list) (list treesit-primary-parser))))))
      (fset 'treesit-ensure-installed ensure))))

(ert-deftest gitfile-ts-mode-rejects-unknown-file-names-before-loading-grammars ()
  (let ((ensure (symbol-function 'treesit-ensure-installed)))
    (unwind-protect
        (progn
          (fset 'treesit-ensure-installed
                (lambda (_language) (ert-fail "Unexpected grammar installation")))
          (dolist (file '(nil "config" "attributes" "exclude" ".git/config"
                              ".GITIGNORE" ".gitConfig" "a.gitattributes.bak"
                              "/tmp/.gitignore/config" ".GITMODULES"
                              ".gitmodules.bak" "test.gitmodules.bak"
                              "/tmp/.gitmodules/config" ".MAILMAP"
                              ".mailmap.bak" "test.mailmap.bak"
                              "/tmp/.mailmap/config"))
            (when file
              (let ((case-fold-search nil))
                (should-not (eq (assoc-default file auto-mode-alist #'string-match)
                                'gitfile-ts-mode))))
            (with-temp-buffer
              (setq buffer-file-name file)
              (should-error (gitfile-ts-mode) :type 'user-error)
              (should-not (treesit-parser-list)))))
      (fset 'treesit-ensure-installed ensure))))

(ert-deftest gitfile-ts-mode-reselects-language-on-restart ()
  (with-temp-buffer
    (setq buffer-file-name ".gitignore")
    (insert "[core]\nfilemode=true\n")
    (gitfile-ts-mode)
    (setq buffer-file-name ".gitconfig")
    (should (eq (treesit-parser-language treesit-primary-parser) 'gitignore))
    (gitfile-ts-mode)
    (should (eq (treesit-parser-language treesit-primary-parser) 'gitconfig))
    (should (equal (treesit-parser-list) (list treesit-primary-parser)))
    (font-lock-ensure)
    (should (eq (gitfile-ts-mode-test--face "core") 'font-lock-type-face))))

(ert-deftest gitfile-ts-mode-generates-autoloads ()
  (let ((output (make-temp-file "gitfile-ts-mode-loaddefs-"))
        (directory (file-name-directory (locate-library "gitfile-ts-mode"))))
    (unwind-protect
        (progn
          (loaddefs-generate directory output nil nil nil t)
          (with-temp-buffer
            (insert-file-contents output)
            (dolist (form '("(autoload 'gitfile-ts-mode" "(add-to-list 'auto-mode-alist"))
              (goto-char (point-min))
              (should (search-forward form nil t)))))
      (delete-file output))))

;;;; Syntax

(ert-deftest gitfile-ts-mode-keeps-quotes-and-backslashes-as-punctuation ()
  (pcase-dolist (`(,file ,source)
                 '((".gitignore" "'`\\\"\n")
                   (".gitattributes" "\"'`\\\"\" text\n")
                   (".gitconfig" "[core]\nvalue=\"'`\\\"\"\n")))
    (with-temp-buffer
      (setq buffer-file-name file)
      (insert source)
      (gitfile-ts-mode)
      (dolist (fragment '("'" "`" "\\" "\""))
        (should (= (gitfile-ts-mode-test--syntax-class fragment) 1))))))

(ert-deftest gitfile-ts-mode-classifies-glob-delimiters ()
  (dolist (file '(".gitignore" ".gitattributes"))
    (with-temp-buffer
      (setq buffer-file-name file)
      (insert "[a-z[:digit:]][[.ch.]][[=e=]]\n\\[literal()]\n")
      (gitfile-ts-mode)
      (pcase-dolist (`(,fragment . ,expected)
                     '(("[a" . 4) ("[:" . 4) (":digit" . 1)
                       (":]" . 1) ("]][[" . 5) ("[." . 1) (".ch" . 1)
                       ("[=" . 1) ("=e" . 1) ("\\[" . 1)
                       ("()]" . 1) (")]" . 1)))
        (should (= (gitfile-ts-mode-test--syntax-class fragment) expected)))
      (should (= (gitfile-ts-mode-test--syntax-class "\\[" 1) 1))
      (should (= (scan-sexps 1 1) (gitfile-ts-mode-test--position "[[.ch.]]"))))))

(ert-deftest gitfile-ts-mode-keeps-encoded-brackets-and-macro-markers-as-punctuation ()
  (let ((treesit-font-lock-level 4))
    (with-temp-buffer
      (setq buffer-file-name ".gitattributes")
      (insert "\"\\133\\133:digit:\\135\\135\" text\n[attr]binary -diff\n")
      (gitfile-ts-mode)
      (font-lock-ensure)
      (syntax-propertize (point-max))
      (dolist (fragment '("\\133" "\\135" "[attr]" "]binary"))
        (should (= (gitfile-ts-mode-test--syntax-class fragment) 1)))
      (should (eq (gitfile-ts-mode-test--face "\\133") 'font-lock-bracket-face))
      (should (eq (gitfile-ts-mode-test--face "\\135") 'font-lock-bracket-face))
      (should (eq (gitfile-ts-mode-test--face "digit") 'font-lock-type-face))
      (should (eq (gitfile-ts-mode-test--face "[attr]") 'font-lock-keyword-face)))))

(ert-deftest gitfile-ts-mode-classifies-config-delimiters ()
  (with-temp-buffer
    (setq buffer-file-name ".gitconfig")
    (insert "[core \"[sub]\"]\nvalue=\"([{}])\"\n[unfinished")
    (gitfile-ts-mode)
    (pcase-dolist (`(,fragment . ,expected)
                   '(("[core" . 4) ("]\nvalue" . 5) ("[sub" . 1)
                     ("\"([" . 1) ("([{" . 1) ("[unfinished" . 4)))
      (should (= (gitfile-ts-mode-test--syntax-class fragment) expected)))))

(ert-deftest gitfile-ts-mode-classifies-only-cst-comments ()
  (pcase-dolist (`(,file ,source ,comments ,literals)
                 '((".gitignore" "# note\n # literal\n\\# escaped\n"
                    ("note") ("literal" "escaped"))
                   (".gitattributes" "  # note\n*.c attr=#literal\n\"#quoted\" attr\n"
                    ("note") ("literal" "quoted"))
                   (".gitconfig" "# note\n[core]\na=\"#quoted;value\" ; inline\nb=next\n"
                    ("note" "inline") ("quoted" "value" "next"))))
    (with-temp-buffer
      (setq buffer-file-name file)
      (insert source)
      (gitfile-ts-mode)
      (syntax-propertize (point-max))
      (dolist (fragment comments)
        (should (nth 4 (syntax-ppss (gitfile-ts-mode-test--position fragment)))))
      (dolist (fragment literals)
        (should-not (nth 4 (syntax-ppss (gitfile-ts-mode-test--position fragment))))))))

(ert-deftest gitfile-ts-mode-preserves-comment-text-through-carriage-returns ()
  (dolist (file '(".gitignore" ".gitattributes" ".gitconfig" ".mailmap"))
    (with-temp-buffer
      (setq buffer-file-name file)
      (insert "# before\rafter\r\nnext\n")
      (gitfile-ts-mode)
      (syntax-propertize (point-max))
      (should (nth 4 (syntax-ppss (gitfile-ts-mode-test--position "after"))))
      (should-not (nth 4 (syntax-ppss (gitfile-ts-mode-test--position "next")))))))

;;;; Comment Commands

(ert-deftest gitfile-ts-mode-comments-and-uncomments ()
  (pcase-dolist (`(,file ,source ,commented)
                 '((".gitignore" "  leading\n\t tab\nplain\n" "#   leading\n# \t tab\n# plain\n")
                   (".gitattributes" "*.c text\n" "# *.c text\n")
                   (".gitconfig" "key=value\n" "# key=value\n")
                   (".mailmap" "Name <old>\n" "# Name <old>\n")))
    (with-temp-buffer
      (setq buffer-file-name file)
      (insert source)
      (gitfile-ts-mode)
      (comment-region (point-min) (point-max))
      (should (equal (buffer-string) commented))
      (uncomment-region (point-min) (point-max))
      (should (equal (buffer-string) source))))
  (with-temp-buffer
    (setq buffer-file-name ".gitconfig")
    (insert "; note\n")
    (gitfile-ts-mode)
    (uncomment-region (point-min) (point-max))
    (should (equal (buffer-string) "note\n"))))

(ert-deftest gitfile-ts-mode-uncomments-multiline-source ()
  (dolist (case
           '(("[core]\nvalue = \"one\\\n# two\" # keep\n" "# [core]\n# value = \"one\\\n# # two\" # keep\n")))
    (with-temp-buffer
      (setq buffer-file-name ".gitconfig")
      (insert (car case))
      (gitfile-ts-mode)
      (let ((state (gitfile-ts-mode-test--buffer-state)))
        (comment-or-uncomment-region (point-min) (point-max))
        (should (equal (buffer-substring-no-properties (point-min) (point-max))
                       (cadr case)))
        (comment-or-uncomment-region (point-min) (point-max))
        (should (equal (buffer-substring-no-properties (point-min) (point-max))
                       (car case)))
        (should (equal (gitfile-ts-mode-test--buffer-state) state))))))

(ert-deftest gitfile-ts-mode-inserts-comments-at-language-boundaries ()
  (pcase-dolist (`(,file ,source ,line ,expected)
                 '((".gitignore" "  build/\n" 1 "# \n  build/\n")
                   (".gitattributes" "*.txt text\n" 1 "# \n*.txt text\n")
                   (".gitconfig" "[core]\nbare = true" 2 "[core]\nbare = true # ")
                   (".gitignore" "" 1 "# ")
                   (".gitattributes" "  " 1 "# ")
                   (".mailmap" "Name <old>" 1 "Name <old> # ")))
    (with-temp-buffer
      (setq buffer-file-name file)
      (insert source)
      (gitfile-ts-mode)
      (setq-local indent-tabs-mode nil)
      (goto-char (point-min))
      (forward-line (1- line))
      (end-of-line)
      (call-interactively (key-binding (kbd "M-;")))
      (should (equal (buffer-substring-no-properties (point-min) (point-max))
                     expected))
      (should (nth 4 (syntax-ppss))))))

;;;; Electric Pair

(ert-deftest gitfile-ts-mode-supplies-electric-pairs ()
  (let ((electric-pair-pairs '((?% . ?%)))
        (electric-pair-mode nil))
    (dolist (file '(".gitignore" ".gitattributes" ".gitconfig"))
      (pcase-dolist (`(,prefix ,opening ,expected)
                     '(("" ?\[ "[]")))
        (ert-info ((format "%S / %c" prefix opening))
          (with-temp-buffer
            (setq buffer-file-name file)
            (insert prefix)
            (gitfile-ts-mode)
            (should-not electric-pair-mode)
            (should (local-variable-p 'electric-pair-pairs))
            (should (equal (assq ?% electric-pair-pairs) '(?% . ?%)))
            (electric-pair-local-mode 1)
            (let ((last-command-event opening)) (self-insert-command 1))
            (should (equal (buffer-string) expected))
            (should (= (point) (1- (point-max))))))))
    (should (equal electric-pair-pairs '((?% . ?%)))))
  (let ((electric-pair-pairs '((?\[ . ?!))))
    (dolist (file '(".gitignore" ".gitattributes" ".gitconfig"))
      (pcase-dolist (`(,prefix ,opening ,expected)
                     '(("" ?\[ "[!")))
        (with-temp-buffer
          (setq buffer-file-name file)
          (insert prefix)
          (gitfile-ts-mode)
          (electric-pair-local-mode 1)
          (let ((last-command-event opening)) (self-insert-command 1))
          (should (equal (buffer-string) expected))
          (should (= (point) (1- (point-max)))))))
    (should (equal electric-pair-pairs '((?\[ . ?!))))))

(ert-deftest gitfile-ts-mode-respects-pair-newline-preferences ()
  (dolist (file '(".gitignore" ".gitattributes" ".gitconfig"))
    (let ((calls 0))
      (pcase-dolist (`(,setting ,expected)
                     (list (list nil "[\n]")
                           (list t "[\n]")
                           (list (lambda () (setq calls (1+ calls)) nil) "[\n]")
                           (list (lambda () (setq calls (1+ calls)) t) "[\n]")))
        (setq calls 0)
        (let ((electric-pair-open-newline-between-pairs setting))
          (with-temp-buffer
            (setq buffer-file-name file)
            (insert "[]")
            (gitfile-ts-mode)
            (electric-indent-local-mode -1)
            (electric-pair-local-mode 1)
            (goto-char 2)
            (call-interactively (key-binding (kbd "RET")))
            (should (equal (buffer-string) expected)))
          (should (eq (> calls 0) nil))
          (should (eq electric-pair-open-newline-between-pairs setting)))))))

(ert-deftest gitfile-ts-mode-pairs-delimiters-and-indents-on-return ()
  (dolist (file '(".gitignore" ".gitattributes" ".gitconfig"))
    (pcase-dolist (`(,prefix ,opening ,expected ,column)
                   '(("" ?\[ "[\n]" 0)))
      (let ((electric-pair-pairs nil)
            (electric-pair-open-newline-between-pairs t))
        (with-temp-buffer
          (setq buffer-file-name file)
          (gitfile-ts-mode)
          (setq-local indent-tabs-mode nil)
          (electric-indent-local-mode 1)
          (electric-pair-local-mode 1)
          (insert prefix)
          (let ((last-command-event opening))
            (self-insert-command 1))
          (call-interactively (key-binding (kbd "RET")))
          (should (equal (buffer-string) expected))
          (should (= (current-column) column)))))))

(ert-deftest gitfile-ts-mode-pairs-quotes-for-selected-language ()
  (let ((electric-pair-pairs nil)
        (electric-pair-text-pairs nil))
    (pcase-dolist (`(,filename ,prefix ,opened ,closed)
                   '(("test.gitconfig" "[core]\nv = "
                      "[core]\nv = \"\"" "[core]\nv = \"x\"")
                     ("test.gitattributes" "" "\"\"" "\"x\"")))
      (with-temp-buffer
        (setq buffer-file-name filename)
        (insert prefix)
        (gitfile-ts-mode)
        (electric-pair-local-mode 1)
        (let ((last-command-event ?\")) (self-insert-command 1))
        (should (equal (buffer-string) opened))
        (should (= (point) (1- (point-max))))
        (let ((last-command-event ?x)) (self-insert-command 1))
        (let ((last-command-event ?\")) (self-insert-command 1))
        (should (equal (buffer-string) closed))
        (should (eobp))))
    (with-temp-buffer
      (setq buffer-file-name "test.gitignore")
      (gitfile-ts-mode)
      (electric-pair-local-mode 1)
      (let ((last-command-event ?\")) (self-insert-command 1))
      (should (equal (buffer-string) "\"")))
    (should-not electric-pair-pairs)))

(ert-deftest gitfile-ts-mode-mailmap-pairs-addresses-and-respects-user-settings ()
  (dolist (custom '(nil ((?< . ?!))))
    (let ((electric-pair-pairs custom)
          (electric-pair-text-pairs nil)
          (electric-pair-open-newline-between-pairs t))
      (with-temp-buffer
        (setq buffer-file-name ".mailmap")
        (gitfile-ts-mode)
        (should-not (assq ?\[ electric-pair-pairs))
        (should-not (assq ?\" electric-pair-pairs))
        (electric-pair-local-mode 1)
        (let ((last-command-event ?<)) (self-insert-command 1))
        (should (equal (buffer-string) (if custom "<!" "<>")))
        (should (= (point) 2))
        (call-interactively (key-binding (kbd "RET")))
        (should (equal (buffer-string) (if custom "<\n!" "<\n>"))))
      (should (equal electric-pair-pairs custom)))))

;;;; Font Lock

(ert-deftest gitfile-ts-mode-fontifies-globs-by-level ()
  (dolist (file '(".gitignore" ".gitattributes"))
    (dolist (level '(1 2 3 4))
      (with-temp-buffer
        (setq buffer-file-name file)
        (insert "# note\n*.c/**/?/[^a-z[:digit:]]/[[.ch.]]/[[=e=]]/\\*\n")
        (let ((treesit-font-lock-level level)) (gitfile-ts-mode))
        (font-lock-ensure)
        (pcase-dolist (`(,fragment ,minimum ,face)
                       '(("#" 1 font-lock-comment-face)
                         ("note" 1 font-lock-comment-face)
                         (".c" 2 font-lock-string-face)
                         ("a-z" 2 font-lock-string-face)
                         ("ch" 2 font-lock-string-face)
                         ("e=" 2 font-lock-string-face)
                         ("digit" 3 font-lock-type-face)
                         ("\\*" 3 font-lock-escape-face)
                         ("*.c" 4 font-lock-constant-face)
                         ("**" 4 font-lock-constant-face)
                         ("?" 4 font-lock-constant-face)
                         ("^" 4 font-lock-negation-char-face)
                         ("-z" 4 font-lock-operator-face)
                         ("/" 4 font-lock-punctuation-face)
                         (":digit" 4 font-lock-punctuation-face)
                         (".ch" 2 font-lock-string-face)
                         ("=e" 2 font-lock-string-face)
                         ("[^" 4 font-lock-bracket-face)
                         ("[:" 4 font-lock-bracket-face)
                         ("[." 2 font-lock-string-face)
                         ("[=" 2 font-lock-string-face)
                         ("]]" 4 font-lock-bracket-face)))
          (ert-info ((format "%s level %s fragment %s" file level fragment))
            (should (eq (gitfile-ts-mode-test--face fragment)
                        (and (>= level minimum) face)))))))))

(ert-deftest gitfile-ts-mode-fontifies-language-specific-leaves-by-level ()
  (pcase-dolist (`(,file ,source ,entries)
                 '((".gitignore" "!keep\n"
                    (("!" 4 font-lock-negation-char-face)))
                   (".gitattributes" "[attr]binary -diff !text eol=auto\n\"a\\t\" attr\n\"\\133attr]\\146oo\" text\n"
                    (("[attr]" 2 font-lock-keyword-face)
                     ("binary" 2 font-lock-variable-name-face)
                     ("text" 2 font-lock-variable-name-face)
                     ("auto" 2 font-lock-string-face)
                     ("\"a" 2 font-lock-string-face)
                     ("\\t" 3 font-lock-escape-face)
                     ("\\133attr]" 2 font-lock-keyword-face)
                     ("\\146" 3 font-lock-escape-face)
                     ("oo\"" 2 font-lock-variable-name-face)
                     ("-diff" 4 font-lock-negation-char-face)
                     ("!text" 4 font-lock-negation-char-face)
                     ("=" 4 font-lock-operator-face)))
                   (".gitconfig" "[includeIf \"gitdir:foo\"]\npath=\"a\\t\"\\\n  true ; note\n"
                    (("includeIf" 2 font-lock-type-face)
                     ("gitdir" 2 font-lock-string-face)
                     ("path" 2 font-lock-property-name-face)
                     ("true" 2 font-lock-string-face)
                     ("\"gitdir" 2 font-lock-string-face)
                     ("\\t" 3 font-lock-escape-face)
                     ("\\\n" 3 font-lock-escape-face)
                     (";" 1 font-lock-comment-face)
                     ("note" 1 font-lock-comment-face)
                     ("=" 4 font-lock-operator-face)
                     ("[" 4 font-lock-bracket-face)
                     ("]" 4 font-lock-bracket-face)))
                   (".gitconfig" "[core]\nleading=\"\"\\\n  first\ninternal=value\\\n  second\n"
                    (("  first" 1 nil)
                     ("first" 2 font-lock-string-face)
                     ("  second" 2 font-lock-string-face)
                     ("\\\n" 3 font-lock-escape-face)))
                   (".gitconfig" "[remote.Origin.more]\nx=y\n[remote.part \"quoted\"]\n"
                    (("remote.Origin" 2 font-lock-type-face)
                     (".Origin" 4 font-lock-punctuation-face)
                     ("Origin.more" 2 font-lock-string-face)
                     ("remote.part" 2 font-lock-type-face)
                     ("quoted" 2 font-lock-string-face)))))
    (dolist (level '(1 2 3 4))
      (with-temp-buffer
        (setq buffer-file-name file)
        (insert source)
        (let ((treesit-font-lock-level level)) (gitfile-ts-mode))
        (font-lock-ensure)
        (pcase-dolist (`(,fragment ,minimum ,face)
                       entries)
          (ert-info ((format "%s level %s fragment %s" file level fragment))
            (should (eq (gitfile-ts-mode-test--face fragment)
                        (and (>= level minimum) face)))))))))

